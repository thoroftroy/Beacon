<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp">
<LinearLayout android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="56dp" android:layout_gravity="center_vertical"
    android:orientation="horizontal" android:background="@drawable/wd_pill" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="10dp">
    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@android:drawable/ic_menu_search" android:tint="#FF6B7078" />
    <TextView android:id="@+id/w_hint" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Search apps, files, sums…" android:textSize="15sp" android:textColor="#FF6B7078" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/w_apps" android:layout_width="wrap_content" android:layout_height="38dp" android:background="@drawable/wd_key_op" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="All apps" android:textSize="13sp" android:textColor="#FF173A66" />
</LinearLayout>
</FrameLayout>
